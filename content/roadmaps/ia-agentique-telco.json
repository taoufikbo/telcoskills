{
  "id": "ia-agentique-telco",
  "titre": "IA, agents et inférence sur plateforme télécom",
  "type": "role",
  "presentation": "Cette roadmap s'adresse à celles et ceux qui doivent héberger, exploiter ou sécuriser de l'IA générative sur une plateforme Kubernetes télécom : modèles ouverts, inférence, GPU, agents, RAG, observabilité, conformité (AI Act, ANSSI) et cas d'usage réseau. Tout part de briques open source.",
  "version": "0.1",
  "provenance": { "type": "editoriale" },
  "source": "Rédaction éditoriale à partir de projets et documentations open source (Hugging Face, vLLM, KServe, llm-d, Kubernetes, Model Context Protocol, OpenTelemetry, OWASP) et de publications de l'ANSSI, de la CNIL et de l'Union européenne ; elle ne s'appuie pas sur une analyse d'offres d'emploi. Le champ 'demande' n'est donc pas renseigné. Ce domaine évolue très vite : vérifier la version et l'état de chaque projet avant de s'y engager.",
  "legende_demande": {
    "forte": "présent dans la majorité des offres",
    "moyenne": "présent dans plusieurs offres",
    "faible": "mentionné ponctuellement ou implicite"
  },
  "blocs": [
    "Prérequis plateforme",
    "Fondations IA",
    "Inférence",
    "Plateforme GPU",
    "Agents et outils",
    "RAG et données",
    "LLMOps et observabilité",
    "Sécurité et conformité IA",
    "IA pour le réseau télécom"
  ],
